{
  "platform": {
    "apiRuntime": "node:22"
  },
  "routes": [
    { "route": "/.auth/*" },
    { "route": "/*", "allowedRoles": ["grill-member"] }
  ],
  "responseOverrides": {
    "401": { "statusCode": 302, "redirect": "/.auth/login/aad" }
  },
  "auth": {
    "rolesSource": "/api/roles",
    "identityProviders": {
      "azureActiveDirectory": {
        "userDetailsClaim": "name",
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/69c1e470-4528-435a-a1ae-de98e0aac738/v2.0",
          "clientIdSettingName": "ENTRA_SWA_CLIENT_ID",
          "clientSecretSettingName": "ENTRA_SWA_CLIENT_SECRET"
        }
      }
    }
  }
}
